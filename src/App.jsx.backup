function Products() {
  const dispatch = useDispatch()
  const wishlistItems = useSelector(state => state.wishlist.items)
  const compareItems = useSelector(state => state.compare.items)

  const [searchTerm, setSearchTerm] = useState('')
  const [selectedCategory, setSelectedCategory] = useState('all')
  const [minPrice, setMinPrice] = useState('')
  const [maxPrice, setMaxPrice] = useState('')
  const [minimumRating, setMinimumRating] = useState('all')
  const [sortBy, setSortBy] = useState('default')

  const { data, isLoading, isError, error } = useQuery({
    queryKey: ['products'],
    queryFn: () => getProducts(100),
  })

  const products = data?.products ?? EMPTY_PRODUCTS

  const categories = useMemo(
    () => [...new Set(products.map(product => product.category).filter(Boolean))].sort(),
    [products]
  )

  const filteredProducts = useMemo(() => {
    let result = [...products]
    const normalizedSearch = searchTerm.trim().toLowerCase()

    if (normalizedSearch) {
      result = result.filter(product =>
        [
          product.title,
          product.description,
          product.category,
          product.brand,
        ]
          .filter(Boolean)
          .some(value => value.toLowerCase().includes(normalizedSearch))
      )
    }

    if (selectedCategory !== 'all') {
      result = result.filter(product => product.category === selectedCategory)
    }

    if (minPrice !== '') {
      result = result.filter(product => product.price >= Number(minPrice))
    }

    if (maxPrice !== '') {
      result = result.filter(product => product.price <= Number(maxPrice))
    }

    if (minimumRating !== 'all') {
      result = result.filter(product => (product.rating || 0) >= Number(minimumRating))
    }

    switch (sortBy) {
      case 'price-low':
        result.sort((a, b) => a.price - b.price)
        break
      case 'price-high':
        result.sort((a, b) => b.price - a.price)
        break
      case 'rating-high':
        result.sort((a, b) => (b.rating || 0) - (a.rating || 0))
        break
      case 'rating-low':
        result.sort((a, b) => (a.rating || 0) - (b.rating || 0))
        break
      case 'name-az':
        result.sort((a, b) => a.title.localeCompare(b.title))
        break
      default:
        break
    }

    return result
  }, [products, searchTerm, selectedCategory, minPrice, maxPrice, minimumRating, sortBy])

  const clearFilters = () => {
    setSearchTerm('')
    setSelectedCategory('all')
    setMinPrice('')
    setMaxPrice('')
    setMinimumRating('all')
    setSortBy('default')
  }

  if (isLoading) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-[#FFF7ED] text-stone-900">
        <LoaderCircle className="animate-spin" size={36} />
        <span className="ml-3">Loading products...</span>
      </div>
    )
  }

  if (isError) {
    return (
      <div className="min-h-screen bg-[#FFF7ED] p-10 text-center text-red-400">
        {error.message}
      </div>
    )
  }

  return (
    <main className="min-h-screen overflow-x-hidden bg-[#FFF7ED] px-4 py-8 text-stone-900 sm:px-6 md:px-12 md:py-12">
      <Navbar />

      <div className="mb-8 mt-10">
        <p className="text-sm font-semibold uppercase tracking-widest text-orange-400">
          Discover your favourites
        </p>
        <h1 className="mt-3 text-4xl font-bold">Explore Products</h1>
        <p className="mt-3 text-slate-400">
          Search, filter and sort products to find exactly what you need.
        </p>
      </div>

      {/* Search and Advanced Filters */}
      <section className="mb-10 rounded-2xl border border-white/10 bg-white p-5 md:p-6">
        <div className="mb-5 flex items-center gap-2">
          <SlidersHorizontal className="text-orange-400" size={20} />
          <h2 className="text-lg font-semibold">Search & Advanced Filters</h2>
        </div>

        <div className="relative mb-5">
          <Search className="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400" size={19} />
          <input
            type="search"
            value={searchTerm}
            onChange={event => setSearchTerm(event.target.value)}
            placeholder="Search by product name, brand, category or description..."
            className="w-full rounded-xl border border-white/10 bg-[#FFF7ED] py-3 pl-12 pr-4 text-stone-900 outline-none transition focus:border-orange-500"
          />
        </div>

        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
          <div>
            <label className="mb-2 block text-sm text-slate-400">Category</label>
            <select
              value={selectedCategory}
              onChange={event => setSelectedCategory(event.target.value)}
              className="w-full rounded-xl border border-white/10 bg-[#FFF7ED] px-3 py-3 text-sm text-stone-900 outline-none focus:border-orange-500"
            >
              <option value="all">All Categories</option>
              {categories.map(category => (
                <option key={category} value={category}>
                  {category.replaceAll('-', ' ')}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label className="mb-2 block text-sm text-slate-400">Minimum Price ($)</label>
            <input
              type="number"
              min="0"
              value={minPrice}
              onChange={event => setMinPrice(event.target.value)}
              placeholder="Min price"
              className="w-full rounded-xl border border-white/10 bg-[#FFF7ED] px-3 py-3 text-sm text-stone-900 outline-none focus:border-orange-500"
            />
          </div>

          <div>
            <label className="mb-2 block text-sm text-slate-400">Maximum Price ($)</label>
            <input
              type="number"
              min="0"
              value={maxPrice}
              onChange={event => setMaxPrice(event.target.value)}
              placeholder="Max price"
              className="w-full rounded-xl border border-white/10 bg-[#FFF7ED] px-3 py-3 text-sm text-stone-900 outline-none focus:border-orange-500"
            />
          </div>

          <div>
            <label className="mb-2 block text-sm text-slate-400">Minimum Rating</label>
            <select
              value={minimumRating}
              onChange={event => setMinimumRating(event.target.value)}
              className="w-full rounded-xl border border-white/10 bg-[#FFF7ED] px-3 py-3 text-sm text-stone-900 outline-none focus:border-orange-500"
            >
              <option value="all">Any Rating</option>
              <option value="4">4★ & above</option>
              <option value="3">3★ & above</option>
              <option value="2">2★ & above</option>
              <option value="1">1★ & above</option>
            </select>
          </div>

          <div>
            <label className="mb-2 block text-sm text-slate-400">Sort By</label>
            <select
              value={sortBy}
              onChange={event => setSortBy(event.target.value)}
              className="w-full rounded-xl border border-white/10 bg-[#FFF7ED] px-3 py-3 text-sm text-stone-900 outline-none focus:border-orange-500"
            >
              <option value="default">Default</option>
              <option value="price-low">Price: Low to High</option>
              <option value="price-high">Price: High to Low</option>
              <option value="rating-high">Rating: High to Low</option>
              <option value="rating-low">Rating: Low to High</option>
              <option value="name-az">Name: A to Z</option>
            </select>
          </div>
        </div>

        <div className="mt-5 flex flex-wrap items-center justify-between gap-3">
          <p className="text-sm text-slate-400">
            Showing <span className="font-semibold text-white">{filteredProducts.length}</span> of{' '}
            <span className="font-semibold text-white">{products.length}</span> products
          </p>
          <button
            onClick={clearFilters}
            className="rounded-lg border border-white/15 px-4 py-2 text-sm font-semibold text-slate-300 transition hover:border-orange-400 hover:text-white"
          >
            Clear Filters
          </button>
        </div>
      </section>

      {filteredProducts.length === 0 ? (
        <div className="rounded-2xl border border-white/10 bg-white px-6 py-16 text-center">
          <Search size={38} className="mx-auto mb-4 text-slate-500" />
          <h2 className="text-xl font-semibold">No products found</h2>
          <p className="mt-2 text-slate-400">
            Try changing your search term or filters.
          </p>
          <button
            onClick={clearFilters}
            className="mt-5 rounded-xl bg-orange-600 px-5 py-3 font-semibold hover:bg-orange-500"
          >
            Reset Filters
          </button>
        </div>
      ) : (
        <div className="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {filteredProducts.map(product => {
            const isWishlisted = wishlistItems.some(item => item.id === product.id)
            const isCompared = compareItems.some(item => item.id === product.id)
            const isCompareFull = compareItems.length >= 4

            return (
              <article
                key={product.id}
                className="overflow-hidden rounded-2xl border border-white/10 bg-white transition hover:-translate-y-1 hover:border-orange-400/50"
              >
                <div className="relative flex h-56 items-center justify-center bg-white p-5">
                  <Link to={`/products/${product.id}`} className="block h-full w-full">
                    <img
                      src={product.thumbnail}
                      alt={product.title}
                      className="h-full w-full object-contain"
                    />
                  </Link>

                  <button
                    onClick={() => dispatch(toggleWishlist(product))}
                    aria-label="Toggle wishlist"
                    className="absolute right-4 top-4 rounded-full bg-slate-100 p-3 text-stone-900 hover:text-red-500"
                  >
                    <Heart
                      size={19}
                      fill={isWishlisted ? 'currentColor' : 'none'}
                      className={isWishlisted ? 'text-red-500' : ''}
                    />
                  </button>
                </div>

                <div className="p-5">
                  <p className="text-xs capitalize text-orange-400">
                    {product.category}
                  </p>

                  <Link
                    to={`/products/${product.id}`}
                    className="mt-2 block min-h-12 font-semibold hover:text-orange-400"
                  >
                    {product.title}
                  </Link>

                  <div className="mt-4 flex items-center justify-between">
                    <span className="text-xl font-bold">${product.price}</span>
                    <span className="text-sm text-yellow-400">★ {product.rating}</span>
                  </div>

                  <button
                    onClick={() => dispatch(addToCompare(product))}
                    disabled={isCompared || isCompareFull}
                    className="mt-5 flex w-full items-center justify-center gap-2 rounded-xl border border-orange-400/40 py-3 font-semibold text-orange-300 transition hover:bg-orange-500/10 disabled:cursor-not-allowed disabled:opacity-50"
                  >
                    <GitCompareArrows size={18} />
                    {isCompared
                      ? 'Added to Compare'
                      : isCompareFull
                        ? 'Compare Limit Reached'
                        : 'Compare Product'}
                  </button>

                  <button
                    onClick={() => dispatch(addToCart(product))}
                    className="mt-3 w-full rounded-xl bg-orange-600 py-3 font-semibold hover:bg-orange-500"
                  >
                    Add to Cart
                  </button>
                </div>
              </article>
            )
          })}
        </div>
      )}
    </main>
  )
}


function Wishlist() {
  const dispatch = useDispatch()
  const wishlistItems = useSelector(state => state.wishlist.items)

  return (
    <main className="min-h-screen overflow-x-hidden bg-[#FFF7ED] px-4 py-8 text-stone-900 sm:px-6 md:px-12 md:py-12">
      <Navbar />

      <div className="mb-10 mt-10">
        <p className="text-sm font-semibold uppercase tracking-widest text-orange-400">
          Your favourites
        </p>
        <h1 className="mt-3 text-4xl font-bold">My Wishlist</h1>
        <p className="mt-3 text-slate-400">
          Products you love, all in one place.
        </p>
      </div>

      {wishlistItems.length === 0 ? (
        <div className="py-20 text-center">
          <Heart size={45} className="mx-auto mb-5 text-slate-600" />
          <h2 className="text-2xl font-semibold">Your wishlist is empty</h2>
          <p className="mt-3 text-slate-400">
            Explore products and add your favourites.
          </p>
          <Link
            to="/products"
            className="mt-6 inline-block rounded-xl bg-orange-600 px-6 py-3 font-semibold hover:bg-orange-500"
          >
            Explore Products
          </Link>
        </div>
      ) : (
        <div className="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {wishlistItems.map(product => (
            <article
              key={product.id}
              className="overflow-hidden rounded-2xl border border-white/10 bg-white"
            >
              <Link
                to={`/products/${product.id}`}
                className="flex h-56 items-center justify-center bg-white p-5"
              >
                <img
                  src={product.thumbnail}
                  alt={product.title}
                  className="h-full w-full object-contain"
                />
              </Link>

              <div className="p-5">
                <h2 className="font-semibold">{product.title}</h2>

                <p className="mt-3 text-xl font-bold">
                  ${product.price}
                </p>

                <div className="mt-5 flex gap-3">
                  <button
                    onClick={() => dispatch(addToCart(product))}
                    className="flex-1 rounded-lg bg-orange-600 py-3 font-semibold hover:bg-orange-500"
                  >
                    Add to Cart
                  </button>

                  <button
                    onClick={() => dispatch(toggleWishlist(product))}
                    className="rounded-lg border border-white/20 px-4 text-red-400 hover:bg-white/10"
                    aria-label="Remove from wishlist"
                  >
                    <Heart size={20} fill="currentColor" />
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </main>
  )
}


function Cart() {
  const dispatch = useDispatch()
  const items = useSelector(state => state.cart.items)

  // Fetch products for cart recommendations
  const { data } = useQuery({
    queryKey: ['cart-recommendation-products'],
    queryFn: () => getProducts(100),
  })

  const products = data?.products ?? EMPTY_PRODUCTS

  const total = items.reduce(
    (sum, item) => sum + item.price * item.quantity,
    0
  )

  return (
    <main className="min-h-screen overflow-x-hidden bg-[#FFF7ED] px-4 py-6 text-stone-900 sm:px-6 sm:py-10">
      <Navbar />

      <h1 className="mb-8 mt-8 text-3xl font-bold sm:text-4xl">
        Your Cart
      </h1>

      {items.length === 0 ? (
        <div className="py-12 text-center">
          <p className="text-slate-400">
            Your cart is empty.
          </p>

          <Link
            to="/"
            className="mt-5 inline-block rounded-xl bg-orange-600 px-6 py-3 font-semibold hover:bg-orange-500"
          >
            Continue Shopping
          </Link>
        </div>
      ) : (
        <div className="w-full max-w-3xl space-y-4">
          {items.map(item => (
            <div
              key={item.id}
              className="flex flex-col gap-4 rounded-xl bg-white p-4 sm:flex-row sm:items-center sm:gap-5 sm:p-5"
            >
              <img
                src={item.thumbnail}
                alt={item.title}
                className="h-24 w-full rounded-lg bg-white object-contain sm:h-20 sm:w-20"
              />

              <div className="flex-1">
                <h2 className="font-semibold">
                  {item.title}
                </h2>

                <p className="mt-2 text-orange-400">
                  ${item.price} × {item.quantity}
                </p>

                <div className="mt-3 flex items-center gap-3">
                  <button
                    onClick={() =>
                      dispatch(
                        updateQuantity({
                          id: item.id,
                          quantity: item.quantity - 1,
                        })
                      )
                    }
                    disabled={item.quantity <= 1}
                    className="rounded bg-slate-700 px-3 py-1 disabled:opacity-40"
                  >
                    −
                  </button>

                  <span>{item.quantity}</span>

                  <button
                    onClick={() =>
                      dispatch(
                        updateQuantity({
                          id: item.id,
                          quantity: item.quantity + 1,
                        })
                      )
                    }
                    disabled={item.quantity >= item.stock}
                    className="rounded bg-slate-700 px-3 py-1 disabled:opacity-40"
                  >
                    +
                  </button>
                </div>
              </div>

              <button
                onClick={() => dispatch(removeFromCart(item.id))}
                className="text-sm text-red-400 hover:text-red-300"
              >
                Remove
              </button>
            </div>
          ))}

          <div className="flex flex-wrap justify-between gap-2 border-t border-white/10 pt-6 text-lg font-bold sm:text-xl">
            <span>Total</span>
            <span>${total.toFixed(2)}</span>
          </div>

          <Link
            to="/checkout"
            className="mt-6 block rounded-xl bg-orange-600 py-4 text-center font-semibold hover:bg-orange-500"
          >
            Proceed to Checkout →
          </Link>
        </div>
      )}

      {/* Cart-Based Recommendations */}
      {items.length > 0 && products.length > 0 && (
        <div className="mt-12">
          <RecommendationRail
            products={products}
            strategy="cart"
            title="Complete Your Shopping"
            description="Recommended add-ons based on products in your cart."
            excludeIds={items.map(item => item.id)}
            limit={4}
          />
        </div>
      )}
    </main>
  )
}


function ComparePage() {
  const dispatch = useDispatch()
  const compareItems = useSelector(state => state.compare.items)

  const cheapest = compareItems.length
    ? compareItems.reduce((best, item) => item.price < best.price ? item : best)
    : null
  const highestRated = compareItems.length
    ? compareItems.reduce((best, item) => item.rating > best.rating ? item : best)
    : null
  const bestValue = compareItems.length
    ? compareItems.reduce((best, item) => {
        const score = item.rating / item.price
        const bestScore = best.rating / best.price
        return score > bestScore ? item : best
      })
    : null

  return (
    <main className="min-h-screen overflow-x-hidden bg-[#FFF7ED] px-4 py-8 text-stone-900 sm:px-6 md:px-12 md:py-10">
      <Navbar />
      <div className="mx-auto mt-10 max-w-7xl">
        <div className="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p className="text-sm font-semibold uppercase tracking-widest text-orange-400">Make a smarter choice</p>
            <h1 className="mt-3 text-4xl font-bold">Product Comparison</h1>
            <p className="mt-3 text-slate-400">Compare up to four products side by side.</p>
          </div>
          {compareItems.length > 0 && (
            <button onClick={() => dispatch(clearCompare())} className="flex items-center gap-2 rounded-lg border border-white/15 px-4 py-2 text-sm text-slate-300 hover:bg-white/10">
              <Trash2 size={16} /> Clear all
            </button>
          )}
        </div>

        {compareItems.length === 0 ? (
          <div className="mt-12 rounded-2xl border border-dashed border-white/15 bg-white/60 px-6 py-16 text-center">
            <GitCompareArrows size={48} className="mx-auto text-orange-400" />
            <h2 className="mt-5 text-2xl font-semibold">No products to compare yet</h2>
            <p className="mt-2 text-slate-400">Visit the products page and select products using Compare Product.</p>
            <Link to="/products" className="mt-6 inline-block rounded-xl bg-orange-600 px-6 py-3 font-semibold hover:bg-orange-500">Explore Products</Link>
          </div>
        ) : (
          <>
            <div className="mt-8 overflow-x-auto rounded-2xl border border-white/10 bg-white">
              <table className="w-full min-w-[760px] border-collapse text-left">
                <thead>
                  <tr className="border-b border-white/10">
                    <th className="w-44 p-5 text-sm text-slate-400">Product details</th>
                    {compareItems.map(product => (
                      <th key={product.id} className="min-w-52 p-5 align-top">
                        <div className="flex justify-end">
                          <button onClick={() => dispatch(removeFromCompare(product.id))} aria-label={`Remove ${product.title}`} className="rounded-lg p-2 text-slate-400 hover:bg-white/10 hover:text-red-400"><X size={18} /></button>
                        </div>
                        <Link to={`/products/${product.id}`}>
                          <div className="flex h-40 items-center justify-center rounded-xl bg-white p-3">
                            <img src={product.thumbnail} alt={product.title} className="h-full w-full object-contain" />
                          </div>
                          <h2 className="mt-4 line-clamp-2 font-semibold text-white hover:text-orange-300">{product.title}</h2>
                        </Link>
                      </th>
                    ))}
                    {compareItems.length < 4 && <th className="min-w-44 p-5 text-center"><Link to="/products" className="inline-flex flex-col items-center gap-2 rounded-xl border border-dashed border-orange-400/40 p-5 text-orange-300 hover:bg-orange-500/10"><GitCompareArrows size={24} />Add product</Link></th>}
                  </tr>
                </thead>
                <tbody>
                  {[
                    ['Price', product => `$${Number(product.price).toFixed(2)}`],
                    ['Rating', product => `★ ${product.rating ?? 'N/A'} / 5`],
                    ['Category', product => product.category || 'N/A'],
                    ['Brand', product => product.brand || 'Not specified'],
                    ['Availability', product => product.stock > 0 ? `In stock (${product.stock})` : 'Out of stock'],
                    ['Discount', product => product.discountPercentage != null ? `${product.discountPercentage}%` : 'N/A'],
                    ['Shipping', product => product.shippingInformation || 'See product details'],
                    ['Warranty', product => product.warrantyInformation || 'Not specified'],
                  ].map(([label, getValue]) => (
                    <tr key={label} className="border-t border-white/10">
                      <th className="p-5 text-sm font-medium text-slate-400">{label}</th>
                      {compareItems.map(product => <td key={product.id} className="p-5 text-sm capitalize text-slate-200">{getValue(product)}</td>)}
                      {compareItems.length < 4 && <td className="p-5 text-slate-600">—</td>}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {compareItems.length >= 2 && (
              <section className="mt-8 rounded-2xl border border-orange-400/20 bg-orange-500/5 p-6">
                <div className="flex items-center gap-2 text-orange-300"><Sparkles size={20} /><h2 className="text-xl font-semibold">Smart Comparison Insights</h2></div>
                <p className="mt-2 text-sm text-slate-400">Rule-based insights calculated from the selected products.</p>
                <div className="mt-5 grid gap-4 md:grid-cols-3">
                  <div className="rounded-xl bg-white p-4"><p className="text-xs uppercase tracking-wide text-slate-400">Lowest price</p><p className="mt-2 font-semibold">{cheapest.title}</p><p className="mt-1 text-orange-300">${Number(cheapest.price).toFixed(2)}</p></div>
                  <div className="rounded-xl bg-white p-4"><p className="text-xs uppercase tracking-wide text-slate-400">Highest rating</p><p className="mt-2 font-semibold">{highestRated.title}</p><p className="mt-1 text-orange-300">★ {highestRated.rating ?? 'N/A'}</p></div>
                  <div className="rounded-xl bg-white p-4"><p className="text-xs uppercase tracking-wide text-slate-400">Best rating-to-price</p><p className="mt-2 font-semibold">{bestValue.title}</p><p className="mt-1 text-orange-300">Based on rating ÷ price</p></div>
                </div>
                <p className="mt-5 text-sm leading-6 text-slate-300">{cheapest.title} is the most affordable option. {highestRated.title} has the highest customer rating. {bestValue.title} offers the strongest rating-to-price ratio among the selected products. Choose based on your budget and priorities.</p>
              </section>
            )}
          </>
        )}
      </div>
    </main>
  )
}


function NotFound() {
  return (
    <div className="min-h-screen bg-[#FFF7ED] p-10 text-stone-900">
      <h1 className="text-3xl font-bold">404 - Page Not Found</h1>
      <Link to="/" className="mt-5 inline-block text-orange-400">
        Go Home
      </Link>
    </div>
  )
}


function ScrollAnimations() {
  useEffect(() => {
    const selector = 'main > section, main > div, main article, main table, main form, .lux-hero-content, .lux-gallery-wrapper, .lux-benefit, .lux-floating-card'
    let observer

    const scan = () => {
      document.querySelectorAll(selector).forEach((element, index) => {
        if (element.dataset.ssReveal) return
        element.dataset.ssReveal = 'true'
        element.classList.add('ss-scroll-reveal')
        element.style.setProperty('--ss-delay', `${(index % 5) * 65}ms`)
        observer.observe(element)
      })
    }

    observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('ss-visible')
          observer.unobserve(entry.target)
        }
      })
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' })

    scan()
    const mutations = new MutationObserver(scan)
    mutations.observe(document.body, { childList: true, subtree: true })

    return () => {
      mutations.disconnect()
      observer.disconnect()
    }
  }, [])

  return null
}

const shopSphereAnimationCSS = `
  html { scroll-behavior: smooth; }
  body { overflow-x: hidden; }
  a, button, article, img { transition: color .25s ease, background-color .25s ease, border-color .25s ease, box-shadow .3s ease, transform .3s ease; }
  button:active, a:active { transform: scale(.98); }
  .ss-scroll-reveal {
    opacity: 0; transform: translate3d(0, 26px, 0);
    transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1);
    transition-delay: var(--ss-delay, 0ms);
  }
  .ss-scroll-reveal.ss-visible { opacity: 1; transform: translate3d(0,0,0); }
  .lux-hero { isolation: isolate; }
  .lux-hero-glow {
    position: absolute; width: 26rem; height: 26rem; border-radius: 50%;
    filter: blur(75px); opacity: .45; pointer-events: none;
    animation: ss-glow-drift 12s ease-in-out infinite alternate;
  }
  .lux-glow-one { top: -9rem; left: -8rem; background: rgba(251,146,60,.28); }
  .lux-glow-two { right: -8rem; bottom: -10rem; background: rgba(234,88,12,.18); animation-delay: -5s; }
  .lux-hero-badge {
    display: inline-flex; align-items: center; border: 1px solid rgba(234,88,12,.2);
    border-radius: 999px; padding: .65rem 1rem; color: #9a3412; background: rgba(255,255,255,.75);
    font-size: .78rem; font-weight: 700; box-shadow: 0 8px 30px rgba(124,45,18,.06);
    backdrop-filter: blur(12px); animation: ss-rise .8s both;
  }
  .lux-gradient-text {
    color: transparent; background: linear-gradient(105deg,#c2410c,#f97316 52%,#a16207);
    -webkit-background-clip: text; background-clip: text;
  }
  .lux-primary-btn, .lux-secondary-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .7rem;
    border-radius: 1rem; padding: .95rem 1.4rem; font-weight: 700;
  }
  .lux-primary-btn { color: white; background: linear-gradient(110deg,#ea580c,#c2410c); box-shadow: 0 14px 30px rgba(194,65,12,.22); }
  .lux-primary-btn:hover { color: white; transform: translateY(-3px); box-shadow: 0 18px 38px rgba(194,65,12,.3); }
  .lux-secondary-btn { color: #7c2d12; border: 1px solid rgba(154,52,18,.2); background: rgba(255,255,255,.75); }
  .lux-secondary-btn:hover { background: white; transform: translateY(-3px); }
  .lux-benefit {
    display: flex; align-items: center; gap: .8rem; padding: 1rem; text-align: left;
    border: 1px solid rgba(120,53,15,.1); border-radius: 1rem; background: rgba(255,255,255,.75);
    box-shadow: 0 8px 24px rgba(120,53,15,.04); backdrop-filter: blur(10px);
  }
  .lux-benefit h4 { color: #292524; font-size: .9rem; font-weight: 800; }
  .lux-benefit p { margin-top: .2rem; color: #78716c; font-size: .75rem; }
  .lux-benefit-icon { display: grid; width: 2.6rem; height: 2.6rem; flex: none; place-items: center; border-radius: .85rem; color: #c2410c; background: #ffedd5; font-size: 1.2rem; }
  .lux-gallery-wrapper { position: relative; max-width: 35rem; margin-inline: auto; }
  .lux-gallery-label { display: flex; align-items: center; justify-content: center; gap: .55rem; margin-bottom: 1rem; color: #78716c; font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .lux-live-dot { width: .5rem; height: .5rem; border-radius: 50%; background: #16a34a; box-shadow: 0 0 0 5px rgba(22,163,74,.12); animation: ss-pulse 1.8s infinite; }
  .lux-gallery-grid { display: grid; height: 34rem; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; overflow: hidden; mask-image: linear-gradient(to bottom,transparent,black 8%,black 92%,transparent); }
  .lux-image-column { display: flex; flex-direction: column; gap: 1rem; }
  .lux-scroll-up { animation: ss-up 28s linear infinite; }
  .lux-scroll-down { animation: ss-down 32s linear infinite; }
  .lux-gallery-grid:hover .lux-image-column { animation-play-state: paused; }
  .lux-image-card { position: relative; flex: none; overflow: hidden; border: 4px solid rgba(255,255,255,.85); border-radius: 1.35rem; background: #f5f5f4; box-shadow: 0 14px 35px rgba(41,37,36,.1); }
  .lux-image-card img { width: 100%; height: 100%; object-fit: cover; }
  .lux-image-card:hover img, article:hover img { transform: scale(1.055); }
  .lux-image-tall { height: 17rem; } .lux-image-small { height: 11rem; } .lux-image-medium { height: 14rem; }
  .lux-image-caption { position: absolute; right: .65rem; bottom: .65rem; left: .65rem; padding: .65rem .8rem; border-radius: .8rem; color: white; background: rgba(28,25,23,.5); font-size: .75rem; font-weight: 700; backdrop-filter: blur(12px); }
  .lux-floating-card { position: absolute; right: -1rem; bottom: 2rem; display: flex; align-items: center; gap: .8rem; padding: 1rem 1.2rem; border: 1px solid rgba(255,255,255,.8); border-radius: 1.1rem; background: rgba(255,255,255,.88); box-shadow: 0 18px 45px rgba(41,37,36,.14); backdrop-filter: blur(16px); animation: ss-float 4s ease-in-out infinite; }
  .lux-floating-icon { display: grid; width: 2.7rem; height: 2.7rem; place-items: center; border-radius: .9rem; color: white; background: linear-gradient(135deg,#f97316,#c2410c); font-size: 1.3rem; }
  .lux-floating-card p { color: #c2410c; font-size: .62rem; font-weight: 800; letter-spacing: .1em; }
  .lux-floating-card h4 { margin-top: .2rem; color: #292524; font-size: .85rem; font-weight: 800; }
  @keyframes ss-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes ss-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @keyframes ss-pulse { 0%,100% { box-shadow: 0 0 0 5px rgba(22,163,74,.12); } 50% { box-shadow: 0 0 0 9px rgba(22,163,74,.04); } }
  @keyframes ss-glow-drift { to { transform: translate3d(28px,20px,0) scale(1.12); } }
  @keyframes ss-up { to { transform: translateY(-50%); } }
  @keyframes ss-down { from { transform: translateY(-50%); } to { transform: translateY(0); } }
  @media (max-width: 640px) {
    .lux-gallery-grid { height: 27rem; gap: .7rem; }
    .lux-image-column { gap: .7rem; }
    .lux-image-tall { height: 14rem; } .lux-image-small { height: 9rem; } .lux-image-medium { height: 11rem; }
    .lux-floating-card { right: -.25rem; bottom: 1rem; padding: .75rem; }
    .lux-floating-card h4 { font-size: .75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    *,*::before,*::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    .ss-scroll-reveal { opacity: 1; transform: none; }
  }
`

export default function App() {
  return (
    <>
      <style>{shopSphereAnimationCSS}</style>
      <ScrollAnimations />
      <Routes>
      <Route path="/" element={<Home />} />
      <Route path="/products" element={<Products />} />
      <Route path="/products/:id" element={<ProductDetails />} />
      <Route path="/wishlist" element={<Wishlist />} />
      <Route path="/compare" element={<ComparePage />} />
      <Route path="/cart" element={<Cart />} />
      <Route path="/checkout" element={<Checkout />} />
      <Route path="*" element={<NotFound />} />
      <Route path="/track-orders" element={<OrderTracking />} />
      <Route path="/order-success" element={<OrderSuccess />} />
      <Route path="/login" element={<Login />} />
      <Route path="/signup" element={<Signup />} />
      <Route path="/profile" element={<Profile />} />
      <Route path="/admin" element={<><Navbar /><AdminDashboard /></>} />
      <Route
  path="/assistant"
  element={
    <>
      <Navbar />
      <AssistantPage />
    </>
  }
/>
      </Routes>
    </>
  )
}
